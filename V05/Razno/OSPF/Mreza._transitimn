node n0 {
    type router
    model quagga
    network-config {
	hostname RT1
	!
	interface eth1
	 mac address 42:00:aa:00:00:02
	!
	interface eth0
	 mac address 42:00:aa:00:00:00
	!
	interface lo0
	 type lo
	 ip address 127.0.0.1/8
	 ipv6 address ::1/128
	!
	!
	!
	!
	router ospf
	 redistribute static
	 redistribute connected
	 redistribute rip
	 network 0.0.0.0/0 area 0.0.0.0
	!
    }
    canvas c0
    iconcoords {312 72}
    labelcoords {312 97}
    interface-peer {eth0 n1}
    interface-peer {eth1 n2}
    custom-configs {
        custom-config-id generic {
            custom-command /usr/local/bin/quaggaboot.sh
            config {
                interface lo0
                 ip address 127.0.0.1/8
                !
                interface eth0
                 ip address 10.1.1.2/24
                 ip ospf cost 1
                !
                interface eth1
                 ip address 10.1.3.1/24
                 ip ospf cost 1
                !
                router ospf
                 router-id 1.1.1.1
                 redistribute static
                 redistribute connected
                 redistribute rip
                 network 10.1.1.0/24 area 1.1.1.1
                 network 10.1.3.0/24 area 1.1.1.1
                !
                
            }
        }
    }
    custom-enabled true
    custom-selected generic
}

