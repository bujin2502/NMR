annotation a0 {
    type rectangle
    iconcoords {611 405 1071 766}
    color #ffccc0
    bordercolor black
    width 1
    canvas c0
}

annotation a1 {
    type rectangle
    iconcoords {611 29 1075 390}
    color #ffa1c0
    bordercolor black
    width 1
    canvas c0
}

annotation a2 {
    type text
    iconcoords {630 431}
    label {LAN2}
    labelcolor black
    font {TkTextFont}
    canvas c0
}

annotation a3 {
    type text
    iconcoords {630 60}
    label {LAN1}
    labelcolor black
    font {TkTextFont}
    canvas c0
}

canvas c0 {
    name {Canvas0}
    size {1400 800}
}

option show {
    interface_names yes
    ip_addresses yes
    ipv6_addresses yes
    node_labels yes
    link_labels yes
    background_images no
    annotations yes
    hostsAutoAssign no
    grid yes
    iconSize normal
    zoom 1.0
}

