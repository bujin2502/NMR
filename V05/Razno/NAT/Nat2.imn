node n0 {
    type router
    model quagga
    network-config {
	hostname usmjernik
	!
	interface eth0
	 ip address 10.0.0.1/24
	 ipv6 address fc00:3::1/64
	 mac address 42:00:aa:00:00:00
	!
	interface eth2
	 ip address 10.0.2.1/24
	 ipv6 address fc00:2::1/64
	 mac address 42:00:aa:00:00:04
	!
	interface eth1
	 ip address 10.0.1.1/24
	 ipv6 address fc00:1::1/64
	 mac address 42:00:aa:00:00:02
	!
	interface lo0
	 type lo
	 ip address 127.0.0.1/8
	 ipv6 address ::1/128
	!
	router rip
	 redistribute static
	 redistribute connected
	 redistribute ospf
	 network 0.0.0.0/0
	!
	router ripng
	 redistribute static
	 redistribute connected
	 redistribute ospf6
	 network ::/0
	!
    }
    canvas c0
    iconcoords {384 384}
    labelcoords {384 409}
    interface-peer {eth1 n2}
    interface-peer {eth2 n3}
    services {tcpdump}
    interface-peer {eth0 n15}
}

node n1 {
    type host
    network-config {
	hostname posluzitelj
	!
	interface eth0
	 ip address 10.0.0.10/24
	 ipv6 address fc00:3::10/64
	 mac address 42:00:aa:00:00:01
	!
	interface lo0
	 type lo
	 ip address 127.0.0.1/8
	 ipv6 address ::1/128
	!
	ip route 0.0.0.0/0 10.0.0.1
	!
	ipv6 route ::/0 fc00:3::1
	!
    }
    canvas c0
    iconcoords {48 384}
    labelcoords {48 420}
    services {ssh}
    interface-peer {eth0 n15}
}

