node n10 {
    type host
    network-config {
	hostname H6
	!
	interface eth0
	 ip address 10.0.12.10/24
	 ipv6 address fc00:c::10/64
	 mac address 42:00:aa:00:00:19
	!
	interface lo0
	 type lo
	 ip address 127.0.0.1/8
	 ipv6 address ::1/128
	!
	ip route 0.0.0.0/0 10.0.12.1
	!
	ipv6 route ::/0 fc00:c::1
	!
