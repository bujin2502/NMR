link l0 {
    delay 20
    color Blue
    nodes {n6 n5}
}

link l1 {
    delay 20
    color Blue
    nodes {n6 n4}
}

link l2 {
    delay 5
    color Green
    nodes {n6 n0}
}

link l3 {
    delay 20
    color Blue
    nodes {n5 n4}
}

link l4 {
    delay 5
    color Green
    nodes {n0 n1}
}

link l5 {
    delay 5
    color Green
    nodes {n0 n7}
}

link l6 {
    delay 5
    color Green
    nodes {n4 n1}
}

link l7 {
    delay 5
    color Green
    nodes {n1 n2}
}

link l8 {
    delay 10
    nodes {n7 n2}
}

link l9 {
    delay 10
    nodes {n7 n3}
}

link l10 {
    delay 10
    nodes {n2 n3}
}

link l11 {
    nodes {n11 n6}
    bandwidth 0
}

link l12 {
    nodes {n10 n7}
    bandwidth 0
}

canvas c0 {
    name {Canvas0}
    size {1600 700}
}

option show {
    interface_names yes
    ip_addresses yes
    ipv6_addresses no
    node_labels yes
    link_labels yes
    background_images no
    annotations yes
    hostsAutoAssign no
    grid yes
    iconSize normal
    zoom 1.0
}

